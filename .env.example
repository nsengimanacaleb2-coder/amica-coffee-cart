# Copy this file to .env and fill in your own values

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=amica_coffee_cart
# Set to "true" when connecting to a cloud MySQL provider that requires TLS (e.g. TiDB Cloud)
DB_SSL=false

# Server
PORT=3000

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Email notifications (optional — leave blank to skip sending real emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Amica House <hello@amicahouse.com>

# Online payments (optional — leave blank to disable the "Pay Online" button)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
